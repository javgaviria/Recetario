---
layout: layouts/base.njk
---
<article class="recipe">
  <a class="back-link" href="/">&larr; Todas las recetas</a>

  <header class="recipe-header">
    <h1 class="recipe-title">{{ title }}</h1>
    {% if description %}<p class="recipe-description">{{ description }}</p>{% endif %}

    <div class="recipe-meta">
      {% if time %}<span class="meta-chip">⏱ {{ time }}</span>{% endif %}
      {% if servings %}<span class="meta-chip">🍽 {{ servings }}</span>{% endif %}
    </div>
  </header>

  {% if image %}
  <div class="recipe-image">
    <img src="{{ image }}" alt="{{ title }}" loading="lazy">
  </div>
  {% endif %}

  <div class="recipe-body">
    <aside class="ingredients-card">
      <h2>Ingredientes</h2>
      {% for group in ingredients | parseIngredients %}
        {% if group.label %}<h3 class="ing-group-label">{{ group.label }}</h3>{% endif %}
        <ul class="ingredients-list">
          {% for item in group.items %}
            <li>{{ item }}</li>
          {% endfor %}
        </ul>
      {% endfor %}
    </aside>

    <div class="steps-card">
      <h2>Preparación</h2>
      <ol class="steps-list">
        {% for step in steps | parseSteps %}
          <li><span class="step-num">{{ loop.index }}</span><span>{{ step }}</span></li>
        {% endfor %}
      </ol>

      {% if notes %}
      <div class="notes">
        <h3>Notas</h3>
        <p>{{ notes }}</p>
      </div>
      {% endif %}
    </div>
  </div>
</article>
